  "source_sha256": "f7e731ffe0b5c10912e02380acd6106cbd45ef365ecc216410ea0ad71f4d284b",
  "cues": [
    {
      "start": 0.15,
      "end": 3.9,
      "text": "Working hard. Still going nowhere?"
    },
    {
      "start": 4.15,
      "end": 8.4,
      "text": "Two brothers. One horse. One cart."
    },
    {
      "start": 8.65,
      "end": 12.9,
      "text": "One brother tied the horse behind the cart. Now it had to push."
    },
    {
      "start": 13.15,
      "end": 18.4,
      "text": "His brother changed the order."
    },
    {
      "start": 18.65,
      "end": 22.9,
      "text": "Same horse. Same cart. A much easier journey."
    },
    {
      "start": 23.15,
      "end": 27.9,
      "text": "That is how I think about my money."
    },
    {
      "start": 28.15,
      "end": 32.9,
      "text": "Buy first, and tomorrow’s income can pay for yesterday’s purchase."
    },
    {
      "start": 33.15,
      "end": 38.9,
      "text": "Save first, and the order changes: earn, save, then buy."
    },
    {
      "start": 39.15,
      "end": 43.9,
      "text": "My “payments” can build savings for the next purchase."
    },
    {
      "start": 44.15,
      "end": 48.9,
      "text": "Put the cart behind the horse."
    }
  ]
}
